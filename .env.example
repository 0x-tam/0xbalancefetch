# GoldRush (Covalent) API key — get one at https://goldrush.dev/
GOLDRUSH_API_KEY=your_api_key_here

# Optional: override output directory (default: ./data/output)
# OUTPUT_DIR=./data/output

# Optional: override cache directory (default: ./data/cache)
# CACHE_DIR=./data/cache

# Optional: log level — debug | info | warn | error (default: info)
# LOG_LEVEL=info
